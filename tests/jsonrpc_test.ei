// http/jsonrpc: the examples of the JSON-RPC 2.0 specification (section 7) answered by a
// Table, typed methods (decoders, encoders, -32602 from a bad parameter), errors with data,
// the HTTP handler's method and media-type checks, and the client's reply parsing.

import "core/sys"
import "std/bytes"
import "std/io"
import "json"
import "../http.ei"
import "../jsonrpc.ei"

type Pair = { a: i64, b: i64 }

fn pair(p: jsonrpc.Params) -> Result[Pair, jsonrpc.Error] {
    p.at_most(2)?
    Ok(Pair(p.int(0, "minuend")?, p.int(1, "subtrahend")?))
}

fn methods() -> jsonrpc.Table {
    let mut t = jsonrpc.table()
    t.add_typed("subtract", pair, jsonrpc.int, |x: Pair| -> Result[i64, jsonrpc.Error] { Ok(x.a - x.b) })
    t.add("sum", |p: jsonrpc.Params| -> Result[List[u8], jsonrpc.Error] {
        let mut s: i64 = 0
        for i in 0..p.count() { s += p.int(i, "")? }
        Ok(jsonrpc.int(s))
    })
    t.add("update", |p: jsonrpc.Params| -> Result[List[u8], jsonrpc.Error] { Ok(jsonrpc.nothing()) })
    t.add("foobar", |p: jsonrpc.Params| -> Result[List[u8], jsonrpc.Error] { Ok(jsonrpc.nothing()) })
    t.add("notify_hello", |p: jsonrpc.Params| -> Result[List[u8], jsonrpc.Error] { Ok(jsonrpc.nothing()) })
    t.add("notify_sum", |p: jsonrpc.Params| -> Result[List[u8], jsonrpc.Error] { Ok(jsonrpc.nothing()) })
    t.add("get_data", |p: jsonrpc.Params| -> Result[List[u8], jsonrpc.Error] {
        p.none()?
        let mut items: List[List[u8]] = List.new()
        items.push(jsonrpc.string(sys.lit("hello")))
        items.push(jsonrpc.int(5))
        Ok(jsonrpc.array(items))
    })
    t.add("greet", |p: jsonrpc.Params| -> Result[List[u8], jsonrpc.Error] {
        let name = p.str(0, "name")?
        let loud = match p.get(1, "loud") {
            Some(n) => p.bool(1, "loud")?
            None => false
        }
        let mut g = sys.lit("hello, ")
        bytes.append(inout g, name)
        if loud { g.push(33) }
        let mut keys: List[List[u8]] = List.new()
        keys.push(sys.lit("greeting"))
        let mut vals: List[List[u8]] = List.new()
        vals.push(jsonrpc.string(g))
        Ok(jsonrpc.object(keys, vals))
    })
    t.add("fail", |p: jsonrpc.Params| -> Result[List[u8], jsonrpc.Error] {
        Err(jsonrpc.error_data(-32001, sys.lit("out of stock"), p.raw(0, "item")?))
    })
    t
}

fn ask(t: jsonrpc.Table, body: str) uses io {
    io.outln(bytes.concat(sys.lit("--> "), sys.lit(body)))
    match t.handle(sys.lit(body)) {
        Some(r) => io.outln(bytes.concat(sys.lit("<-- "), r))
        None => print("<-- (nothing)")
    }
}

fn show_http(r: http.Response) uses io {
    let mut l = bytes.from_u64(r.status as u64)
    match r.header("allow") {
        Some(v) => {
            bytes.append(inout l, sys.lit(" allow="))
            bytes.append(inout l, v)
        }
        None => {}
    }
    match r.header("content-type") {
        Some(v) => {
            bytes.append(inout l, sys.lit(" type="))
            bytes.append(inout l, v)
        }
        None => {}
    }
    l.push(32)
    bytes.append(inout l, r.body)
    io.outln(l)
}

fn show_reply(r: Result[jsonrpc.Reply, String]) uses io {
    match r {
        Ok(jsonrpc.Value(d, n)) => io.outln(bytes.concat(sys.lit("value "), json.write(d, n)))
        Ok(jsonrpc.Fault(e)) => {
            let mut l = sys.lit("fault ")
            bytes.append(inout l, bytes.from_i64(e.code))
            l.push(32)
            bytes.append(inout l, e.message)
            l.push(32)
            bytes.append(inout l, e.data)
            io.outln(l)
        }
        Err(e) => print(e)
    }
}

fn main() uses io {
    let t = methods()
    print("-- the specification's examples")
    ask(t, "{\"jsonrpc\": \"2.0\", \"method\": \"subtract\", \"params\": [42, 23], \"id\": 1}")
    ask(t, "{\"jsonrpc\": \"2.0\", \"method\": \"subtract\", \"params\": [23, 42], \"id\": 2}")
    ask(t, "{\"jsonrpc\": \"2.0\", \"method\": \"subtract\", \"params\": {\"subtrahend\": 23, \"minuend\": 42}, \"id\": 3}")
    ask(t, "{\"jsonrpc\": \"2.0\", \"method\": \"update\", \"params\": [1,2,3,4,5]}")
    ask(t, "{\"jsonrpc\": \"2.0\", \"method\": \"foobar\"}")
    ask(t, "{\"jsonrpc\": \"2.0\", \"method\": \"foobaz\", \"id\": \"1\"}")
    ask(t, "{\"jsonrpc\": \"2.0\", \"method\": \"foobar, \"params\": \"bar\", \"baz]")
    ask(t, "{\"jsonrpc\": \"2.0\", \"method\": 1, \"params\": \"bar\"}")
    ask(t, "[{\"jsonrpc\": \"2.0\", \"method\": \"sum\", \"params\": [1,2,4], \"id\": \"1\"},{\"jsonrpc\": \"2.0\", \"method\"]")
    ask(t, "[]")
    ask(t, "[1]")
    ask(t, "[1,2,3]")
    ask(t, "[{\"jsonrpc\": \"2.0\", \"method\": \"sum\", \"params\": [1,2,4], \"id\": \"1\"}, {\"jsonrpc\": \"2.0\", \"method\": \"notify_hello\", \"params\": [7]}, {\"jsonrpc\": \"2.0\", \"method\": \"subtract\", \"params\": [42,23], \"id\": \"2\"}, {\"foo\": \"boo\"}, {\"jsonrpc\": \"2.0\", \"method\": \"foo.get\", \"params\": {\"name\": \"myself\"}, \"id\": \"5\"}, {\"jsonrpc\": \"2.0\", \"method\": \"get_data\", \"id\": \"9\"}]")
    ask(t, "[{\"jsonrpc\": \"2.0\", \"method\": \"notify_sum\", \"params\": [1,2,4]}, {\"jsonrpc\": \"2.0\", \"method\": \"notify_hello\", \"params\": [7]}]")

    print("-- requests that are not quite right")
    ask(t, "{\"jsonrpc\": \"1.0\", \"method\": \"sum\", \"id\": 4}")
    ask(t, "{\"method\": \"sum\", \"id\": 4}")
    ask(t, "{\"jsonrpc\": \"2.0\", \"method\": \"sum\", \"params\": 3, \"id\": 4}")
    ask(t, "{\"jsonrpc\": \"2.0\", \"method\": \"sum\", \"id\": [4]}")
    ask(t, "{\"jsonrpc\": \"2.0\", \"method\": \"sum\", \"id\": null}")
    ask(t, "{\"jsonrpc\": \"2.0\", \"method\": \"subtract\", \"params\": [1], \"id\": 5}")
    ask(t, "{\"jsonrpc\": \"2.0\", \"method\": \"subtract\", \"params\": [1, \"x\"], \"id\": 6}")
    ask(t, "{\"jsonrpc\": \"2.0\", \"method\": \"subtract\", \"params\": [1, 2, 3], \"id\": 7}")
    ask(t, "{\"jsonrpc\": \"2.0\", \"method\": \"get_data\", \"params\": [1], \"id\": 8}")
    ask(t, "{\"jsonrpc\": \"2.0\", \"method\": \"greet\", \"params\": {\"name\": \"Ada \\\"L\\\"\", \"loud\": true}, \"id\": 9}")
    ask(t, "{\"jsonrpc\": \"2.0\", \"method\": \"greet\", \"params\": [\"Bob\", 1], \"id\": 10}")
    ask(t, "{\"jsonrpc\": \"2.0\", \"method\": \"fail\", \"params\": {\"item\": {\"sku\": 12}}, \"id\": 11}")
    ask(t, "{\"jsonrpc\": \"2.0\", \"method\": \"fail\", \"params\": {\"item\": 1}}")
    ask(t, "  ")
    let mut big = jsonrpc.table()
    big.max_batch = 2
    big.add("x", |p: jsonrpc.Params| -> Result[List[u8], jsonrpc.Error] { Ok(jsonrpc.int(1)) })
    ask(big, "[{\"jsonrpc\":\"2.0\",\"method\":\"x\",\"id\":1},{\"jsonrpc\":\"2.0\",\"method\":\"x\",\"id\":2},{\"jsonrpc\":\"2.0\",\"method\":\"x\",\"id\":3}]")

    print("-- over HTTP")
    let h = jsonrpc.handler(t)
    let mut get = http.request("GET", sys.lit("/rpc"))
    show_http(h(get))
    let mut post = http.request("POST", sys.lit("/rpc"))
    post.body = sys.lit("{\"jsonrpc\":\"2.0\",\"method\":\"sum\",\"params\":[1,2],\"id\":1}")
    show_http(h(post))
    post.set_header("Content-Type", sys.lit("text/plain"))
    show_http(h(post))
    post.headers = List.new()
    post.set_header("content-type", sys.lit("Application/JSON; charset=utf-8"))
    show_http(h(post))
    post.body = sys.lit("{\"jsonrpc\":\"2.0\",\"method\":\"update\"}")
    show_http(h(post))

    print("-- the client's view of replies")
    io.outln(jsonrpc.request_body(sys.lit("subtract"), sys.lit("[42,23]"), Some(7)))
    io.outln(jsonrpc.request_body(sys.lit("update"), List.new(), None))
    show_reply(jsonrpc.parse_reply(sys.lit("{\"jsonrpc\":\"2.0\",\"result\":{\"a\":[1,2]},\"id\":7}"), 7))
    show_reply(jsonrpc.parse_reply(sys.lit("{\"jsonrpc\":\"2.0\",\"error\":{\"code\":-32601,\"message\":\"Method not found\"},\"id\":7}"), 7))
    show_reply(jsonrpc.parse_reply(sys.lit("{\"jsonrpc\":\"2.0\",\"error\":{\"code\":-32700,\"message\":\"Parse error\",\"data\":\"x\"},\"id\":null}"), 7))
    show_reply(jsonrpc.parse_reply(sys.lit("{\"jsonrpc\":\"2.0\",\"result\":1,\"id\":8}"), 7))
    show_reply(jsonrpc.parse_reply(sys.lit("{\"jsonrpc\":\"2.0\",\"result\":1,\"error\":{},\"id\":7}"), 7))
    show_reply(jsonrpc.parse_reply(sys.lit("{\"result\":1,\"id\":7}"), 7))
    show_reply(jsonrpc.parse_reply(sys.lit("{\"jsonrpc\":\"2.0\",\"result\":1}"), 7))
    show_reply(jsonrpc.parse_reply(sys.lit("not json"), 7))
}
