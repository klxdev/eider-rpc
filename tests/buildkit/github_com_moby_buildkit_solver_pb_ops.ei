pub type NetMode = | UNSET | HOST | NONE

pub fn net_mode_num(x: NetMode) -> i32 {
    match x {
        UNSET => 0
        HOST => 1
        NONE => 2
    }
}

pub fn net_mode_from(n: i32) -> Option[NetMode] {
    if n == 0 { return Some(UNSET) }
    if n == 1 { return Some(HOST) }
    if n == 2 { return Some(NONE) }
    None
}

pub const NetMode_UNSET: i32 = 0
pub const NetMode_HOST: i32 = 1
pub const NetMode_NONE: i32 = 2

