// kvstore: an example JSON-RPC 2.0 service on eider-rpc and eider-http (docs/jsonrpc.md).
//
// Methods (POST /rpc, `Content-Type: application/json`):
//   kv.put(key, value)  -> the previous value, or null
//   kv.get(key)         -> the value, or null
//   kv.delete(key)      -> true if the key was there
//   kv.keys()           -> every key, in insertion order
//   math.add(a, b), math.div(a, b) -> an integer; division by zero is error -32000
//   kv.stats()          -> {"keys": n, "valueBytes": n}
// Parameters are positional (`[k, v]`) or named (`{"key": k, "value": v}`). The math methods'
// named parameters and kv.stats's result go through eider-json's derived codecs (`Two`,
// `Stats`): decoding is strict (a member other than `a` and `b` is invalid params, with the
// member's path in the error data).
// Also GET /health (`ok`) and GET /kv/:key (the value as text, or 404).
//
// The store is shared by every worker thread through a sync.Lock: each method is one
// critical section (`modify`, which changes the store in place), so concurrent calls see a
// consistent store.

import core.sys
import std.bytes
import std.sync
import json
import http
import http.router
import rpc.jsonrpc
import http.profiling

// `keys` keeps insertion order for kv.keys (iterating the Map gives its slot order)
type Kv = { keys: List[List[u8]], vals: Map[List[u8], List[u8]] }

/// The service's state; copies share it.
pub type Store = { st: sync.Lock[Kv] }

pub fn store() -> Store { Store(sync.lock(Kv(List.new(), Map.new()))) }

fn opt_string(v: Option[List[u8]]) -> List[u8] {
    match v {
        Some(s) => jsonrpc.string(s)
        None => jsonrpc.nothing()
    }
}

type Put = { key: List[u8], value: List[u8] }

fn put_args(p: jsonrpc.Params) -> Result[Put, jsonrpc.Error] {
    p.at_most(2)?
    Ok(Put(p.str(0, "key")?, p.str(1, "value")?))
}

fn key_arg(p: jsonrpc.Params) -> Result[List[u8], jsonrpc.Error] {
    p.at_most(1)?
    p.str(0, "key")
}

type Two = { a: i64, b: i64 }

impl json.Decode for Two {
    fn decode(inout r: json.Reader) -> Result[Two, json.DecodeError] { json.decode_record(inout r) }
    fn missing() -> Option[Two] { None }
}

fn two_ints(p: jsonrpc.Params) -> Result[Two, jsonrpc.Error] {
    if p.named() {
        // `{"a": 1, "b": 2}`: the derived decoder (eider-json), which rejects other members
        let mut r = json.reader(p.doc, p.node)
        return match Two.decode(inout r) {
            Ok(t) => Ok(t)
            Err(e) => Err(jsonrpc.invalid_params(json.decode_error_text(e)))
        }
    }
    p.at_most(2)?
    Ok(Two(p.int(0, "a")?, p.int(1, "b")?))
}

/// kv.stats's result, written by the derived encoder.
@[json(rename_all = "camelCase")]
type Stats = { keys: u64, value_bytes: u64 }

impl json.Encode for Stats {
    fn encode(self, inout w: json.Writer) { json.encode_record(self, inout w) }
}

impl Store {
    fn put(self, k: List[u8], v: List[u8]) -> Option[List[u8]] {
        self.st.modify(|inout s: Kv| -> Option[List[u8]] {
            let old = s.vals.get(k)
            if old.is_none() { s.keys.push(k) }
            s.vals.insert(k, v)
            old
        })
    }

    fn get(self, k: List[u8]) -> Option[List[u8]] {
        self.st.modify(|inout s: Kv| -> Option[List[u8]] s.vals.get(k))
    }

    fn delete(self, k: List[u8]) -> bool {
        self.st.modify(|inout s: Kv| -> bool {
            if !s.vals.contains(k) { return false }
            s.vals.remove(k)
            let mut keep: List[List[u8]] = List.new()
            for x in s.keys {
                if !bytes.eq(x, k) { keep.push(x) }
            }
            s.keys = keep
            true
        })
    }

    fn keys(self) -> List[List[u8]] { self.st.modify(|inout s: Kv| -> List[List[u8]] s.keys) }

    fn stats(self) -> Stats {
        self.st.modify(|inout s: Kv| -> Stats {
            let mut n: u64 = 0
            for k in s.keys {
                match s.vals.get(k) {
                    Some(v) => { n += v.len() as u64 }
                    None => {}
                }
            }
            Stats(s.keys.len() as u64, n)
        })
    }
}

/// The JSON-RPC methods over `s`.
pub fn rpc(s: Store) -> jsonrpc.Table {
    let mut t = jsonrpc.table()
    t.add_typed("kv.put", put_args, opt_string, |a: Put| -> Result[Option[List[u8]], jsonrpc.Error] { Ok(s.put(a.key, a.value)) })
    t.add_typed("kv.get", key_arg, opt_string, |k: List[u8]| -> Result[Option[List[u8]], jsonrpc.Error] { Ok(s.get(k)) })
    t.add_typed("kv.delete", key_arg, jsonrpc.boolean, |k: List[u8]| -> Result[bool, jsonrpc.Error] { Ok(s.delete(k)) })
    t.add("kv.keys", |p: jsonrpc.Params| -> Result[List[u8], jsonrpc.Error] {
        p.none()?
        let mut items: List[List[u8]] = List.new()
        for k in s.keys() { items.push(jsonrpc.string(k)) }
        Ok(jsonrpc.array(items))
    })
    t.add("kv.stats", |p: jsonrpc.Params| -> Result[List[u8], jsonrpc.Error] {
        p.none()?
        Ok(json.to_json(s.stats()))
    })
    t.add_typed("math.add", two_ints, jsonrpc.int, |x: Two| -> Result[i64, jsonrpc.Error] {
        // checked: an overflow is an error for the caller, not a trap in the server
        if (x.b > 0 && x.a > 9223372036854775807 - x.b) || (x.b < 0 && x.a < -9223372036854775807 - 1 - x.b) {
            return Err(jsonrpc.error(-32001, "integer overflow"))
        }
        Ok(x.a + x.b)
    })
    t.add_typed("math.div", two_ints, jsonrpc.int, |x: Two| -> Result[i64, jsonrpc.Error] {
        if x.b == 0 { return Err(jsonrpc.error(-32000, "division by zero")) }
        if x.b == -1 && x.a == -9223372036854775807 - 1 { return Err(jsonrpc.error(-32001, "integer overflow")) }
        Ok(x.a / x.b)
    })
    t
}

/// The whole service: /rpc, /health and /kv/:key, each route under the profiler's `method`
/// and `route` labels (eider-http's http/profiling; nothing without --profile).
pub fn app(s: Store) -> http.Handler {
    let mut r = routes(s)
    profiling.label_routes(inout r)
    router.handler(r)
}

/// `app` plus the profiler's /debug/profile and /debug/heap when `o` enables them (main.ei:
/// KVSTORE_PROFILING=1).
pub fn app_with(s: Store, o: profiling.Options) -> http.Handler uses fs, io, clock {
    let mut r = routes(s)
    profiling.label_routes(inout r)
    profiling.mount(inout r, o)
    router.handler(r)
}

fn routes(s: Store) -> router.Router {
    let mut r = router.new()
    r.post("/rpc", jsonrpc.handler(rpc(s)))
    r.get("/health", |q: http.Request| -> http.Response { http.text(200, "ok") })
    r.get("/kv/:key", |q: http.Request| -> http.Response {
        match s.get(q.param("key").unwrap()) {
            Some(v) => http.respond(200, "text/plain; charset=utf-8", v)
            None => http.error_response(404)
        }
    })
    r
}
