// kvstore: an example JSON-RPC 2.0 service on packages/http (docs/services.md).
//
// Methods (POST /rpc, `Content-Type: application/json`):
//   kv.put(key, value)  -> the previous value, or null
//   kv.get(key)         -> the value, or null
//   kv.delete(key)      -> true if the key was there
//   kv.keys()           -> every key, in insertion order
//   math.add(a, b), math.div(a, b) -> an integer; division by zero is error -32000
// Parameters are positional (`[k, v]`) or named (`{"key": k, "value": v}`).
// Also GET /health (`ok`) and GET /kv/:key (the value as text, or 404).
//
// The store is shared by every worker thread through a sync.Lock: each method is one
// critical section, so concurrent calls see a consistent store.

import "core/sys"
import "std/bytes"
import "std/sync"
import "http"
import "http/router"
import "http/jsonrpc"

type Kv = { keys: List[List[u8]], vals: Map[List[u8], List[u8]] }

/// The service's state; copies share it.
pub type Store = { st: sync.Lock[Kv] }

pub fn store() -> Store { Store(sync.lock(Kv(List.new(), Map.new()))) }

fn opt_string(v: Option[List[u8]]) -> List[u8] {
    match v {
        Some(s) => jsonrpc.string(s)
        None => jsonrpc.nothing()
    }
}

type Put = { key: List[u8], value: List[u8] }

fn put_args(p: jsonrpc.Params) -> Result[Put, jsonrpc.Error] {
    p.at_most(2)?
    Ok(Put(p.str(0, "key")?, p.str(1, "value")?))
}

fn key_arg(p: jsonrpc.Params) -> Result[List[u8], jsonrpc.Error] {
    p.at_most(1)?
    p.str(0, "key")
}

type Two = { a: i64, b: i64 }

fn two_ints(p: jsonrpc.Params) -> Result[Two, jsonrpc.Error] {
    p.at_most(2)?
    Ok(Two(p.int(0, "a")?, p.int(1, "b")?))
}

impl Store {
    fn put(self, k: List[u8], v: List[u8]) -> Option[List[u8]] {
        self.st.with(|s: Kv| -> (Kv, Option[List[u8]]) {
            let mut t = s.copy()
            let old = t.vals.get(k)
            if old.is_none() { t.keys.push(k) }
            t.vals.insert(k, v)
            (t, old)
        })
    }

    fn get(self, k: List[u8]) -> Option[List[u8]] {
        self.st.with(|s: Kv| -> (Kv, Option[List[u8]]) {
            let v = s.vals.get(k)
            (s, v)
        })
    }

    fn delete(self, k: List[u8]) -> bool {
        self.st.with(|s: Kv| -> (Kv, bool) {
            let mut t = s.copy()
            if !t.vals.contains(k) { return (t, false) }
            t.vals.remove(k)
            let mut keep: List[List[u8]] = List.new()
            for x in t.keys {
                if !bytes.eq(x, k) { keep.push(x) }
            }
            t.keys = keep
            (t, true)
        })
    }

    fn keys(self) -> List[List[u8]] { self.st.with(|s: Kv| -> (Kv, List[List[u8]]) (s, s.keys)) }
}

/// The JSON-RPC methods over `s`.
pub fn rpc(s: Store) -> jsonrpc.Table {
    let mut t = jsonrpc.table()
    t.add_typed("kv.put", put_args, opt_string, |a: Put| -> Result[Option[List[u8]], jsonrpc.Error] { Ok(s.put(a.key, a.value)) })
    t.add_typed("kv.get", key_arg, opt_string, |k: List[u8]| -> Result[Option[List[u8]], jsonrpc.Error] { Ok(s.get(k)) })
    t.add_typed("kv.delete", key_arg, jsonrpc.boolean, |k: List[u8]| -> Result[bool, jsonrpc.Error] { Ok(s.delete(k)) })
    t.add("kv.keys", |p: jsonrpc.Params| -> Result[List[u8], jsonrpc.Error] {
        p.none()?
        let mut items: List[List[u8]] = List.new()
        for k in s.keys() { items.push(jsonrpc.string(k)) }
        Ok(jsonrpc.array(items))
    })
    t.add_typed("math.add", two_ints, jsonrpc.int, |x: Two| -> Result[i64, jsonrpc.Error] {
        // checked: an overflow is an error for the caller, not a trap in the server
        if (x.b > 0 && x.a > 9223372036854775807 - x.b) || (x.b < 0 && x.a < -9223372036854775807 - 1 - x.b) {
            return Err(jsonrpc.error(-32001, "integer overflow"))
        }
        Ok(x.a + x.b)
    })
    t.add_typed("math.div", two_ints, jsonrpc.int, |x: Two| -> Result[i64, jsonrpc.Error] {
        if x.b == 0 { return Err(jsonrpc.error(-32000, "division by zero")) }
        if x.b == -1 && x.a == -9223372036854775807 - 1 { return Err(jsonrpc.error(-32001, "integer overflow")) }
        Ok(x.a / x.b)
    })
    t
}

/// The whole service: /rpc, /health and /kv/:key.
pub fn app(s: Store) -> fn(http.Request) -> http.Response {
    let mut r = router.new()
    r.post("/rpc", jsonrpc.handler(rpc(s)))
    r.get("/health", |q: http.Request| -> http.Response { http.text(200, "ok") })
    r.get("/kv/:key", |q: http.Request| -> http.Response {
        match s.get(q.param("key").unwrap()) {
            Some(v) => http.respond(200, "text/plain; charset=utf-8", v)
            None => http.error_response(404)
        }
    })
    router.handler(r)
}
