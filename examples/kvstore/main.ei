// kvstore: run the example service (kv.ei) on 127.0.0.1.
//
//   scripts/ei run examples/kvstore/main.ei [port]      (default 8080; 0: any free port)
//   curl -s localhost:8080/rpc -H 'Content-Type: application/json' \
//        -d '{"jsonrpc":"2.0","method":"kv.put","params":["a","1"],"id":1}'
//
// SIGTERM or SIGINT (Ctrl-C) shuts it down gracefully: requests in flight finish, idle
// connections close, then it prints what it served. Plain HTTP only: put it behind a
// TLS-terminating proxy to expose it (docs/services.md "Security posture").

import "core/sys"
import "std/bytes"
import "std/env"
import "std/fd"
import "std/io"
import "std/net"
import "std/signal"
import "std/task"
import "std/time"
import "http/server"
import "http/profiling"
import "kv.ei"

fn port_arg() -> i32 uses io {
    let a = env.args()
    if a.len() < 2 { return 8080 }
    match bytes.parse_u64(a[1]) {
        Some(p) => {
            if p > 65535 {
                io.errln(sys.lit("kvstore: the port is 0 to 65535"))
                env.exit(2)
            }
            p as i32
        }
        None => {
            io.errln(sys.lit("usage: kvstore [port]"))
            env.exit(2)
            0
        }
    }
}

fn main() uses io, fs, net, clock, threads {
    let srv = match server.listen(net.ipv4(127, 0, 0, 1, port_arg()), server.config()) {
        Ok(s) => s
        Err(e) => {
            io.errln(e.bytes())
            env.exit(1)
            return
        }
    }
    let mut l = sys.lit("kvstore: listening on http://")
    bytes.append(inout l, net.text(srv.addr()))
    io.outln(l)

    // TERM and INT arrive on the signal pipe; a thread waits for one and cancels the server
    let tok = task.root()
    signal.watch(signal.TERM).unwrap()
    signal.watch(signal.INT).unwrap()
    let sig_fd = signal.events_fd().unwrap()
    let t = tok
    let waiter = spawn(|| -> i32 {
        let mut going = true
        while going {
            match fd.wait_ready(sig_fd, fd.READY_READ, t.deadline()) {
                Ok(true) => {
                    if signal.pending().unwrap_or(List.new()).len() > 0 { going = false }
                }
                Ok(false) => { going = false }
                Err(e) => { going = false }
            }
        }
        t.cancel()
        0
    })

    // the profiler's endpoints, only on request (a binary built with --profile; docs/runtime.md)
    let mut prof = profiling.options()
    match env.get(sys.lit("KVSTORE_PROFILING")) {
        Some(v) => { prof.enabled = bytes.eq(v, sys.lit("1")) }
        None => {}
    }
    match srv.serve(kv.app_with(kv.store(), prof), tok) {
        Ok(st) => {
            let mut m = String.from("kvstore: stopped after ")
            m.append(String.from_int(st.requests))
            m.push_str(" requests on ")
            m.append(String.from_int(st.connections))
            m.push_str(" connections")
            print(m)
        }
        Err(e) => io.errln(e.bytes())
    }
    let z = waiter.join()
}
