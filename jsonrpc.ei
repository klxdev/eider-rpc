//! http/jsonrpc: JSON-RPC 2.0 (https://www.jsonrpc.org/specification) over HTTP POST, on
//! packages/json: the first RPC milestone (decision C7).
//!
//! Server side: a `Table` maps method names to handlers. A handler gets the call's `Params`
//! (typed accessors: `p.int(0, "a")` reads positional parameter 0 or named parameter `a`) and
//! returns its result as JSON text or an `Error`. `add_typed` adds a method from a decoder, an
//! encoder and a typed function, so parameter and result conversions are written once per
//! type and a bad parameter becomes `-32602 Invalid params` by itself. `handle` answers a
//! request body (one call or a batch); `handler` makes a Table an HTTP handler: POST only
//! (405 otherwise), `Content-Type: application/json` (415 otherwise), 200 with the response,
//! or 204 when every call was a notification.
//!
//! What the spec asks, and how it is met:
//! - a body that isn't JSON: -32700 Parse error (id null); a request that isn't an object
//!   with `"jsonrpc": "2.0"`, a string `method`, `params` absent or an array or object, and
//!   an `id` absent or a string, number or null: -32600 Invalid Request (with the id when it
//!   could be read, else null);
//! - an unknown method: -32601; invalid parameters: -32602; a handler's own errors keep their
//!   code (-32000 to -32099 are for servers, other codes for applications);
//! - notifications (no `id`) get no response, also when they fail;
//! - a batch is an array of requests answered by an array of the responses that aren't for
//!   notifications (no response at all if there are none); an empty array is one -32600; a
//!   batch longer than `max_batch` (default 100) is one -32600.
//! Results are written in the order of the calls (the spec allows any order). Calls in a
//! batch run one after another on the connection's worker.
//!
//! Client side: `call` sends one request on a client.Conn and returns the result or the
//! error; `notify` sends a notification.

import "core/sys"
import "std/bytes"
import "std/time"
import "json"
import "http.ei"
import "client.ei"

pub const PARSE_ERROR: i64 = -32700
pub const INVALID_REQUEST: i64 = -32600
pub const METHOD_NOT_FOUND: i64 = -32601
pub const INVALID_PARAMS: i64 = -32602
pub const INTERNAL_ERROR: i64 = -32603

/// An error object. `data` is JSON text (empty: none).
pub type Error = { code: i64, message: List[u8], data: List[u8] }

pub fn error(code: i64, message: str) -> Error { Error(code, sys.lit(message), List.new()) }

/// An error with `data` (JSON text).
pub fn error_data(code: i64, message: List[u8], data: List[u8]) -> Error { Error(code, message, data) }

pub fn invalid_params(why: List[u8]) -> Error { Error(INVALID_PARAMS, sys.lit("Invalid params"), json.quote(why)) }

// ---- parameters

/// A call's parameters: `node` in `doc` is an array or an object (`present` false: the call
/// had none).
pub type Params = { doc: json.Doc, node: u32, present: bool }

fn missing(i: u32, name: str) -> Error {
    let mut m = sys.lit("missing parameter ")
    bytes.append(inout m, sys.lit(name))
    bytes.append(inout m, sys.lit(" (position "))
    bytes.append(inout m, bytes.from_u64(i as u64))
    m.push(41)
    invalid_params(m)
}

fn wrong(name: str, what: str) -> Error {
    let mut m = sys.lit("parameter ")
    bytes.append(inout m, sys.lit(name))
    bytes.append(inout m, sys.lit(" must be "))
    bytes.append(inout m, sys.lit(what))
    invalid_params(m)
}

impl Params {
    /// Named parameters (an object), rather than positional ones (an array).
    fn named(self) -> bool { self.present && json.kind(self.doc, self.node) == json.OBJECT }

    /// How many parameters there are.
    fn count(self) -> u32 {
        if !self.present { return 0 }
        json.len(self.doc, self.node)
    }

    /// The node of positional parameter `i`, or of the member `name` when named.
    fn get(self, i: u32, name: str) -> Option[u32] {
        if !self.present { return None }
        if self.named() { return json.field(self.doc, self.node, name) }
        json.at(self.doc, self.node, i)
    }

    fn int(self, i: u32, name: str) -> Result[i64, Error] {
        let n = self.get(i, name).ok_or(missing(i, name))?
        json.as_int(self.doc, n).ok_or(wrong(name, "an integer"))
    }

    fn str(self, i: u32, name: str) -> Result[List[u8], Error] {
        let n = self.get(i, name).ok_or(missing(i, name))?
        json.as_str(self.doc, n).ok_or(wrong(name, "a string"))
    }

    fn bool(self, i: u32, name: str) -> Result[bool, Error] {
        let n = self.get(i, name).ok_or(missing(i, name))?
        json.as_bool(self.doc, n).ok_or(wrong(name, "true or false"))
    }

    /// The parameter as JSON text (any type).
    fn raw(self, i: u32, name: str) -> Result[List[u8], Error] {
        let n = self.get(i, name).ok_or(missing(i, name))?
        Ok(json.write(self.doc, n))
    }

    /// Ok when there are no parameters (absent, `[]` or `{}`).
    fn none(self) -> Result[bool, Error] {
        if self.count() == 0 { return Ok(true) }
        Err(invalid_params(sys.lit("this method takes no parameters")))
    }

    /// Ok when there are at most `n` parameters (extra ones are an error, not ignored).
    fn at_most(self, n: u32) -> Result[bool, Error] {
        if self.count() <= n { return Ok(true) }
        Err(invalid_params(sys.lit("too many parameters")))
    }
}

// ---- results as JSON text

pub fn int(v: i64) -> List[u8] { bytes.from_i64(v) }
pub fn string(v: List[u8]) -> List[u8] { json.quote(v) }
pub fn boolean(v: bool) -> List[u8] { if v { sys.lit("true") } else { sys.lit("false") } }
/// JSON `null` (a result for methods that return nothing).
pub fn nothing() -> List[u8] { sys.lit("null") }

/// An array of JSON texts.
pub fn array(items: List[List[u8]]) -> List[u8] {
    let mut out = sys.lit("[")
    bytes.append(inout out, bytes.join(items, sys.lit(",")))
    out.push(93)
    out
}

/// An object from keys and JSON texts (the shorter list decides).
pub fn object(keys: List[List[u8]], vals: List[List[u8]]) -> List[u8] {
    let mut out = sys.lit("{")
    let n = if keys.len() < vals.len() { keys.len() } else { vals.len() }
    for i in 0..n {
        if i > 0 { out.push(44) }
        json.quote_into(inout out, keys[i])
        out.push(58)
        bytes.append(inout out, vals[i])
    }
    out.push(125)
    out
}

// ---- the dispatch table

/// A method: its parameters to its result as JSON text, or an error.
pub type Method = fn(Params) -> Result[List[u8], Error]

pub type Table = {
    names: Map[List[u8], usize],
    methods: List[Method],
    max_batch: usize,
}

pub fn table() -> Table { Table(Map.new(), List.new(), 100) }

/// A method from a decoder for its parameters, an encoder for its result and the typed
/// function between them.
pub fn typed[P, R](decode: fn(Params) -> Result[P, Error], encode: fn(R) -> List[u8], f: fn(P) -> Result[R, Error]) -> Method {
    |p: Params| -> Result[List[u8], Error] {
        let args = decode(p)?
        let r = f(args)?
        Ok(encode(r))
    }
}

impl Table {
    /// Adds method `name` (a second method with one name is a programming error: panic).
    fn add(inout self, name: str, m: Method) {
        let key = sys.lit(name)
        if self.names.contains(key) { panic("jsonrpc: a method is added twice") }
        self.names.insert(key, self.methods.len())
        self.methods.push(m)
    }

    /// `add(name, typed(decode, encode, f))`.
    fn add_typed[P, R](inout self, name: str, decode: fn(Params) -> Result[P, Error], encode: fn(R) -> List[u8], f: fn(P) -> Result[R, Error]) {
        self.add(name, typed(decode, encode, f))
    }

    /// The response body for a request body (see the module comment); None when nothing is
    /// to be sent back (only notifications).
    fn handle(self, body: List[u8]) -> Option[List[u8]] {
        let d = match json.parse(body) {
            Ok(x) => x
            Err(e) => {
                let err = error_data(PARSE_ERROR, sys.lit("Parse error"), json.quote(json.error_text(e)))
                return Some(error_reply(nothing(), err))
            }
        }
        let root = d.root
        if json.kind(d, root) != json.ARRAY { return self.one(d, root) }
        let n = json.len(d, root)
        if n == 0 { return Some(error_reply(nothing(), error(INVALID_REQUEST, "Invalid Request"))) }
        if (n as usize) > self.max_batch {
            return Some(error_reply(nothing(), error_data(INVALID_REQUEST, sys.lit("Invalid Request"), json.quote(sys.lit("batch too large")))))
        }
        let mut outs: List[List[u8]] = List.new()
        for i in 0..n {
            match self.one(d, json.at(d, root, i).unwrap()) {
                Some(r) => outs.push(r)
                None => {}
            }
        }
        if outs.len() == 0 { return None }
        Some(array(outs))
    }

    fn one(self, d: json.Doc, node: u32) -> Option[List[u8]] {
        let bad = error(INVALID_REQUEST, "Invalid Request")
        if json.kind(d, node) != json.OBJECT { return Some(error_reply(nothing(), bad)) }
        let mut id_text = nothing()
        let mut id_ok = true
        let id = json.field(d, node, "id")
        match id {
            Some(i) => {
                let k = json.kind(d, i)
                if k == json.STRING || k == json.NUMBER || k == json.NULL {
                    id_text = json.write(d, i)
                } else {
                    id_ok = false
                }
            }
            None => {}
        }
        let version_ok = match json.field(d, node, "jsonrpc") {
            Some(v) => bytes.eq(json.as_str(d, v).unwrap_or(List.new()), sys.lit("2.0"))
            None => false
        }
        let method: Option[List[u8]] = match json.field(d, node, "method") {
            Some(m) => json.as_str(d, m)
            None => None
        }
        let mut params = Params(d, 0, false)
        let mut params_ok = true
        match json.field(d, node, "params") {
            Some(p) => {
                let k = json.kind(d, p)
                if k == json.ARRAY || k == json.OBJECT { params = Params(d, p, true) } else { params_ok = false }
            }
            None => {}
        }
        if !id_ok { return Some(error_reply(nothing(), bad)) }
        if !version_ok || method.is_none() || !params_ok { return Some(error_reply(id_text, bad)) }
        let notification = id.is_none()
        let name = method.unwrap()
        let r: Result[List[u8], Error] = match self.names.get(name) {
            Some(k) => {
                let m = self.methods[k]
                m(params)
            }
            None => Err(error(METHOD_NOT_FOUND, "Method not found"))
        }
        if notification { return None }
        match r {
            Ok(v) => {
                let mut out = sys.lit("{\"jsonrpc\":\"2.0\",\"result\":")
                bytes.append(inout out, v)
                bytes.append(inout out, sys.lit(",\"id\":"))
                bytes.append(inout out, id_text)
                out.push(125)
                Some(out)
            }
            Err(e) => Some(error_reply(id_text, e))
        }
    }
}

fn error_reply(id_text: List[u8], e: Error) -> List[u8] {
    let mut out = sys.lit("{\"jsonrpc\":\"2.0\",\"error\":{\"code\":")
    bytes.append(inout out, bytes.from_i64(e.code))
    bytes.append(inout out, sys.lit(",\"message\":"))
    json.quote_into(inout out, e.message)
    if e.data.len() > 0 {
        bytes.append(inout out, sys.lit(",\"data\":"))
        bytes.append(inout out, e.data)
    }
    bytes.append(inout out, sys.lit("},\"id\":"))
    bytes.append(inout out, id_text)
    out.push(125)
    out
}

/// The table as an HTTP handler (see the module comment).
pub fn handler(t: Table) -> http.Handler {
    |req: http.Request| -> http.Response {
        if !bytes.eq(req.method, sys.lit("POST")) {
            let mut r = http.error_response(405)
            r.set_header("Allow", sys.lit("POST"))
            return r
        }
        if !bytes.eq(req.content_type(), sys.lit("application/json")) { return http.error_response(415) }
        match t.handle(req.body) {
            Some(b) => http.json_response(200, b)
            None => http.response(204)
        }
    }
}

// ---- client

/// What a call returned: its result (`node` in `doc`) or its error.
pub type Reply = | Value(doc: json.Doc, node: u32) | Fault(e: Error)

/// A request body: `params` is JSON text (an array or object; empty for none); `id` None
/// makes it a notification.
pub fn request_body(method: List[u8], params: List[u8], id: Option[i64]) -> List[u8] {
    let mut out = sys.lit("{\"jsonrpc\":\"2.0\",\"method\":")
    json.quote_into(inout out, method)
    if params.len() > 0 {
        bytes.append(inout out, sys.lit(",\"params\":"))
        bytes.append(inout out, params)
    }
    match id {
        Some(n) => {
            bytes.append(inout out, sys.lit(",\"id\":"))
            bytes.append(inout out, bytes.from_i64(n))
        }
        None => {}
    }
    out.push(125)
    out
}

/// A response body to a call with `id`: Err when it isn't a valid JSON-RPC 2.0 response to it.
pub fn parse_reply(body: List[u8], id: i64) -> Result[Reply, String] {
    let d = match json.parse(body) {
        Ok(x) => x
        Err(e) => {
            let mut m = String.from("jsonrpc: response is not JSON: ")
            m.append(sys.to_string(json.error_text(e)))
            return Err(m)
        }
    }
    let r = d.root
    let ok_version = match json.field(d, r, "jsonrpc") {
        Some(v) => bytes.eq(json.as_str(d, v).unwrap_or(List.new()), sys.lit("2.0"))
        None => false
    }
    if json.kind(d, r) != json.OBJECT || !ok_version { return Err(String.from("jsonrpc: not a JSON-RPC 2.0 response")) }
    let res = json.field(d, r, "result")
    let er = json.field(d, r, "error")
    match json.field(d, r, "id") {
        Some(i) => {
            if json.as_int(d, i) != Some(id) && !(er.is_some() && json.is_null(d, i)) {
                return Err(String.from("jsonrpc: response for another id"))
            }
        }
        None => { return Err(String.from("jsonrpc: response without an id")) }
    }
    if res.is_some() == er.is_some() { return Err(String.from("jsonrpc: a response has exactly one of result and error")) }
    match res {
        Some(n) => { return Ok(Value(d, n)) }
        None => {}
    }
    let e = er.unwrap()
    let code: Option[i64] = match json.field(d, e, "code") {
        Some(c) => json.as_int(d, c)
        None => None
    }
    let msg: Option[List[u8]] = match json.field(d, e, "message") {
        Some(m) => json.as_str(d, m)
        None => None
    }
    if code.is_none() || msg.is_none() { return Err(String.from("jsonrpc: malformed error object")) }
    let data: List[u8] = match json.field(d, e, "data") {
        Some(x) => json.write(d, x)
        None => List.new()
    }
    Ok(Fault(Error(code.unwrap(), msg.unwrap(), data)))
}

fn post(inout c: client.Conn, target: List[u8], body: List[u8], dl: time.Deadline) -> Result[http.Response, String] uses net, io, clock {
    let mut req = http.request("POST", target)
    req.set_header("Content-Type", sys.lit("application/json"))
    req.body = body
    c.request(req, dl)
}

/// Calls `method` with `params` (JSON text; empty for none) at `target` on `c`, with id `id`.
pub fn call(inout c: client.Conn, target: str, method: str, params: List[u8], id: i64, dl: time.Deadline) -> Result[Reply, String] uses net, io, clock {
    let resp = post(inout c, sys.lit(target), request_body(sys.lit(method), params, Some(id)), dl)?
    if resp.status != 200 {
        let mut m = String.from("jsonrpc: HTTP status ")
        m.append(String.from_int(resp.status as i64))
        return Err(m)
    }
    parse_reply(resp.body, id)
}

/// Sends a notification (no reply expected: Ok when the server answered 204).
pub fn notify(inout c: client.Conn, target: str, method: str, params: List[u8], dl: time.Deadline) -> Result[bool, String] uses net, io, clock {
    let resp = post(inout c, sys.lit(target), request_body(sys.lit(method), params, None), dl)?
    if resp.status != 204 {
        let mut m = String.from("jsonrpc: HTTP status ")
        m.append(String.from_int(resp.status as i64))
        return Err(m)
    }
    Ok(true)
}
