//! rpc/service: typed services over JSON-RPC with no hand-written decoders or encoders. A
//! method is a function from a parameter type `P` to `Result[R, Error]`; `P` and `R` are
//! records, enums, lists... that are `serial.Serialize` and `serial.Deserialize` (derive them
//! with `@[derive(Serialize, Deserialize)]`; `@[serial(...)]` and `@[json(...)]` apply), so the
//! parameters are checked and converted by the same reflection that converts every other JSON
//! value, and a bad parameter is `-32602 Invalid params` with the path of the offending member
//! (`amount: expected a u32, ...`).
//!
//! A service is a trait of your own, and the same trait describes both ends:
//!
//!     trait Billing {
//!         fn charge(self, req: Charge) -> Result[Receipt, jsonrpc.Error]
//!         fn refund(self, req: Refund) -> Result[Receipt, jsonrpc.Error]
//!     }
//!
//!     impl Billing for Ledger { ... }                     // the server's implementation
//!     impl service.Service for Ledger {                   // its registration, one line a method
//!         fn register(self, inout r: service.Registry) {
//!             r.add_json("charge", |q: Charge| self.charge(q))
//!             r.add_json("refund", |q: Refund| self.refund(q))
//!         }
//!     }
//!     impl Billing for BillingClient { ... }              // a stub: `self.remote.call("billing.charge", req)`
//!                                                          // (`rpc/remote`, the typed client, is a module of its own)
//!
//!     service.mount(inout table, "billing", ledger)       // methods billing.charge, billing.refund
//!
//! The registration and the stub are written by hand: eider 0.4.0's reflection covers the fields
//! and variants of a type, not the methods of a trait or the parameters of a function, so a
//! library can't enumerate `Billing` (eider-lang#154, "Function and trait reflection"). Everything else is derived: parameter and result conversion on both
//! sides, positional parameters mapped onto a record's fields, the method name prefix, error
//! mapping. When the language can enumerate a trait's methods, `register` and the stub are the
//! only things that become generated.
//!
//! Parameters: `add_json` takes a record `P`: the call's `params` as an object are `P`'s
//! members, as an array they are `P`'s fields in order (skipped fields don't count), absent
//! they are `{}` (fine when every field is an Option or `@[serial(default)]`). `add_value` takes any
//! `P` and decodes the `params` array or object itself (a `List[i64]`, an enum), and `add_none`
//! a method without parameters.

import core.sys
import std.bytes
import std.serial
import json
import http
import rpc.jsonrpc

/// Methods are added under a prefix (`billing.`).
pub type Registry = { t: jsonrpc.Table, prefix: List[u8] }

/// A service's registration (see the module comment).
pub trait Service {
    fn register(self, inout r: Registry)
}

/// Mounts `svc` on `t`: every method it registers is named `<prefix>.<name>`.
pub fn mount[S: Service](inout t: jsonrpc.Table, prefix: str, svc: S) {
    let mut p = sys.lit(prefix)
    if p.len() > 0 { p.push(46) }
    let mut r = Registry(t.copy(), p)
    svc.register(inout r)
    t = r.t
}

fn decode_failed(e: serial.Error) -> jsonrpc.Error {
    jsonrpc.invalid_params(serial.error_text(e))
}

/// `r` as JSON text, or why it can't be (a NaN): an internal error.
pub fn encoded[R: serial.Serialize](r: R) -> Result[List[u8], jsonrpc.Error] {
    match json.to_bytes(r) {
        Ok(b) => Ok(b)
        Err(e) => Err(jsonrpc.error_data(jsonrpc.INTERNAL_ERROR, sys.lit("Invalid result"), json.quote(serial.error_text(e))))
    }
}

/// The call's parameters as a `P` (a record): an object is P's members, an array is its fields
/// in order, no parameters are `{}`.
pub fn params_as[P: serial.Deserialize](p: jsonrpc.Params) -> Result[P, jsonrpc.Error] {
    let mut d = p.doc.copy()
    let mut node = p.node.copy()
    if !p.present {
        node = json.new_object(inout d, List.new(), List.new())
    } else if !p.named() {
        let none: Option[P] = None
        let names = serial.member_names(none, "json")
        if (json.len(d, node) as usize) > names.len() { return Err(jsonrpc.invalid_params(sys.lit("too many parameters"))) }
        let mut keys: List[List[u8]] = List.new()
        let mut vals: List[u32] = List.new()
        for i in 0..json.len(d, node) {
            keys.push(names[i as usize].copy())
            vals.push(json.at(d, node, i).unwrap())
        }
        node = json.new_object(inout d, keys, vals)
    }
    match P.deserialize(json.deserializer(d, node)) {
        Ok(x) => Ok(x)
        Err(e) => Err(decode_failed(e))
    }
}

/// The `params` node itself as a `P` (an array or object, whatever P decodes from).
pub fn value_as[P: serial.Deserialize](p: jsonrpc.Params) -> Result[P, jsonrpc.Error] {
    if !p.present { return Err(jsonrpc.invalid_params(sys.lit("parameters are required"))) }
    match P.deserialize(json.deserializer(p.doc, p.node)) {
        Ok(x) => Ok(x)
        Err(e) => Err(decode_failed(e))
    }
}

impl Registry {
    fn full(self, name: str) -> List[u8] { bytes.concat(self.prefix, sys.lit(name)) }

    /// A method whose parameters are the members (or, positionally, the fields) of record P.
    fn add_json[P: serial.Deserialize, R: serial.Serialize](inout self, name: str, f: fn(P) -> Result[R, jsonrpc.Error]) {
        let full = self.full(name)
        self.t.add_bytes(full, |p: jsonrpc.Params| -> Result[List[u8], jsonrpc.Error] {
            let got: Result[P, jsonrpc.Error] = params_as(p)
            let args = got?
            let r = f(args)?
            encoded(r)
        })
    }

    /// A method whose parameters are the array or object that P decodes from.
    fn add_value[P: serial.Deserialize, R: serial.Serialize](inout self, name: str, f: fn(P) -> Result[R, jsonrpc.Error]) {
        let full = self.full(name)
        self.t.add_bytes(full, |p: jsonrpc.Params| -> Result[List[u8], jsonrpc.Error] {
            let got: Result[P, jsonrpc.Error] = value_as(p)
            let args = got?
            let r = f(args)?
            encoded(r)
        })
    }

    /// A method without parameters.
    fn add_none[R: serial.Serialize](inout self, name: str, f: fn() -> Result[R, jsonrpc.Error]) {
        let full = self.full(name)
        self.t.add_bytes(full, |p: jsonrpc.Params| -> Result[List[u8], jsonrpc.Error] {
            p.none()?
            let r = f()?
            encoded(r)
        })
    }
}
